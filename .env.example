# Copy to .env.local for local development (git-ignored). For staging/production builds, set these in the build
# environment (CI or hosting dashboard). Do NOT create .env.production: `next build` loads it automatically, so the
# local check build and the Playwright tests would start sending requests to the real API.
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time and are PUBLIC. They hold only the public
# API location and flags. Never put secrets, API keys, SendGrid keys, SPRY credentials or tokens in NEXT_PUBLIC_
# variables — backend credentials stay in the Laravel backend's own .env. Changing a value requires a rebuild.

# Base URL of the Laravel API.
#   local:      http://localhost:8000/api/v1
#   staging:    https://api-staging.stridephysical.com/api/v1
#   production: https://api.stridephysical.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# true  = offline demo adapter; nothing is sent anywhere and the form is labelled as a demo (default when unset).
# false = real HTTP adapter (staging and production).
NEXT_PUBLIC_USE_MOCK_API=true

# Request timeout for the HTTP adapter, in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Server-only (never sent to the browser as configuration):
# "staging" shows the staging notice and adds noindex, nofollow to every page. Leave empty locally and in production.
SITE_ENV=
# Canonical origin for canonical/Open Graph URLs, sitemap.xml and robots.txt. Production: https://stridephysical.com
SITE_URL=
